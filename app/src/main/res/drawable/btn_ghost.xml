    <item android:state_hovered="true"><shape><solid android:color="@color/card_hi"/><corners android:radius="10dp"/><stroke android:width="2dp" android:color="@color/accent_dim"/></shape></item>
    <item><shape><solid android:color="@color/card"/><corners android:radius="10dp"/><stroke android:width="1dp" android:color="#334050"/></shape></item>
